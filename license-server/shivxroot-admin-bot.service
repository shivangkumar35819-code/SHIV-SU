[Unit]
Description=SHIV KSU Telegram license administration
After=network-online.target shivxroot-login.service
Wants=network-online.target

[Service]
Type=simple
User=shivxroot-login
Group=shivxroot-login
WorkingDirectory=/opt/shivxroot-login
EnvironmentFile=/etc/shivxroot-login.env
EnvironmentFile=/etc/shivxroot-admin-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/shivxroot-login/.venv/bin/python /opt/shivxroot-login/admin_bot.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shivxroot-login

[Install]
WantedBy=multi-user.target
